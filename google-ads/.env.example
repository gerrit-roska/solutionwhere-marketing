# Google Ads agent secrets — NAMES ONLY. Values are never committed (.gitignore covers .env).
# Copy this file to .env inside the scaffolded agent folder and fill the blanks.
# Account IDs are NOT here — they live in client.config.json and the engine copies
# them into GOOGLE_ADS_CUSTOMER_ID / GOOGLE_ADS_LOGIN_CUSTOMER_ID at runtime.

# --- Always required -----------------------------------------------------------
# Google Ads API developer token (MCC-level). Sent as the developer-token header
# on every call. One shared token across the MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Auth mode 1 (PREFERRED): service account -----------------------------------
# The service account must be granted direct access on the Ads account. Scope:
# https://www.googleapis.com/auth/adwords . Supply EITHER the inline JSON (option A)
# OR a file path (option B), not both.
#   Option A (Railway/pod-friendly): the full SA JSON key as a single string.
GOOGLE_ADS_SA_KEY_JSON=
#   Option B: a FILE PATH to the SA JSON key (never the JSON contents).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Auth mode 2 (FALLBACK): OAuth refresh token --------------------------------
# Only if the service-account path is blocked. All three required together.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Set at runtime by the engine (do NOT hand-fill) ----------------------------
# applyClientEnv() copies these from client.config.json.google_ads.* each run.
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
