{
  "name": "solutionwhere-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run -w @app/dashboard dev",
    "build": "npm run -w @app/dashboard build",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npm run -w @app/core db:migrate",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 2 && npm run db:migrate",
    "job:seo-publish-daily": "npm run -w @app/jobs job:seo-publish-daily --",
    "job:list-build-nightly": "npm run -w @app/jobs job:list-build-nightly --",
    "job:verify-emails-daily": "npm run -w @app/jobs job:verify-emails-daily --",
    "job:aeo-panel-monthly": "npm run -w @app/jobs job:aeo-panel-monthly --",
    "job:rfp-watch-daily": "npm run -w @app/jobs job:rfp-watch-daily --",
    "job:keyword-refresh-quarterly": "npm run -w @app/jobs job:keyword-refresh-quarterly --",
    "job:google-ads-daily": "npm run -w @app/jobs job:google-ads-daily --",
    "job:fb-creative-factory-weekly": "npm run -w @app/jobs job:fb-creative-factory-weekly --",
    "job:fb-upload-drafts-weekly": "npm run -w @app/jobs job:fb-upload-drafts-weekly --",
    "job:fb-manage-daily": "npm run -w @app/jobs job:fb-manage-daily --",
    "job:ads-guardrails-daily": "npm run -w @app/jobs job:ads-guardrails-daily --",
    "job:leads-waterfall": "npm run -w @app/jobs job:leads-waterfall --",
    "job:people-sequence": "npm run -w @app/jobs job:people-sequence --"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.0"
  }
}
