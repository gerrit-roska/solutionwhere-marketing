# Facebook Ads agent secrets - NAMES ONLY, values are never committed.
# Fleet convention: shared keys plain; per-client keys <CLIENT>_-prefixed.
# The human supplies every value in .env (gitignored). A missing value must
# raise at runtime, never fall back to a hardcoded default (a hardcoded token
# fallback in the reference lineage is exactly what that rule prevents).

# --- Meta Marketing API (required) -------------------------------------------
# The token NAME is also declared in client.config.json meta_ads.access_token_env.
# Token is passed in the URL query, never an Authorization header (multipart 401).
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=
FB_PAGE_ID=

# --- Creative generation (required) ------------------------------------------
# OpenRouter drives the creative brief (Claude) and image/video generation.
# If a client uses Kie.ai image-to-image instead, set KIE_TOKEN too.
OPENROUTER_API_KEY=
KIE_TOKEN=
KIE_UPLOAD_TOKEN=

# --- Vision QA (required before go-live) --------------------------------------
# vision-qa.mjs grades every rendered creative against config.brand with an
# Anthropic vision model (default claude-opus-4-8; override via config
# vision_qa.model) and writes a provenance-stamped verdict artifact per
# creative (<runDir>/<creative_id>/vision-review.json). Per-client key from
# the client's own Anthropic workspace - never shared across projects. The
# 'vision-qa' acceptance criterion stays PENDING until verdicts exist and
# FAILS on any verdict without provenance.
ANTHROPIC_API_KEY=

# --- Optional creative research / video ---------------------------------------
# APIFY_TOKEN: competitor ad-library scraping (creative-intel stage).
# HEYGEN_*: persona/talking-photo video. Per-persona photo ids are
# <CLIENT>_ or _<PERSONA>-suffixed, e.g. HEYGEN_TALKING_PHOTO_ID_OVERWHELMED_OPERATOR.
APIFY_TOKEN=
HEYGEN_API_KEY=
HEYGEN_TALKING_PHOTO_ID=
HEYGEN_VOICE_ID=

# --- Dashboard warehouse (optional) ------------------------------------------
# Read-only token for the cross-channel Graphed warehouse dashboard.
DASHBOARD_WAREHOUSE_TOKEN=

# --- Daily report delivery (optional) ----------------------------------------
# The pipeline always writes report.md/report.json; it posts to Slack ONLY when
# this webhook is set and the run is not DRY_RUN. Offline never posts.
SLACK_WEBHOOK_URL=

# --- Google Search Console enrichment (OPTIONAL, fleet-inherited) -------------
# fb-ads does NOT consume GSC (creative is selected by Meta conversion
# performance, not organic search). These two NAMES ship present-but-blank and
# unused; kept for fleet consistency. See docs/CONTRACTS.md section 7.
#   GSC_SERVICE_ACCOUNT_JSON = FILE PATH to the service-account JSON key (the
#                              PATH, never the JSON contents; never committed).
#   GSC_PROPERTY_URL         = the property EXACTLY as GSC returns it (protocol,
#                              sc-domain: prefix, trailing slash all matter).
GSC_SERVICE_ACCOUNT_JSON=
GSC_PROPERTY_URL=
